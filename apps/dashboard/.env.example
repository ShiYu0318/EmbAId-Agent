# Public URL of the EmbAId API. The dashboard calls it from the browser, and the embed
# snippet it generates points visitors' browsers at it too, so in production this must be
# the API's public https URL, not localhost. Read at build time (next build).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: serve widget.js from somewhere else (a CDN). Defaults to <NEXT_PUBLIC_API_URL>/widget.js.
# NEXT_PUBLIC_WIDGET_URL=
