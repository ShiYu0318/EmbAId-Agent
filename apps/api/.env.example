# EmbAId Agent API settings. Copy to .env and fill in the lines marked REQUIRED,
# or let the setup wizard do it: uv run python -m src.setup
# Every value can also be set as an environment variable of the same name.

# --- Server ---------------------------------------------------------------
ENVIRONMENT=development                 # development | staging | production
API_PUBLIC_URL=http://localhost:8000    # public URL of this API (OAuth callbacks, links)
DASHBOARD_URL=http://localhost:3000     # where the dashboard runs
CORS_ORIGINS=http://localhost:3000      # comma-separated; add every dashboard origin
# REQUIRED: a long random secret for signing logins. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=

# --- Security -------------------------------------------------------------
# Requests per minute from one client address, across all keys. 0 turns it off.
# Behind a reverse proxy, set FORWARDED_ALLOW_IPS so the real client address is used.
RATE_LIMIT_PER_IP=600
# memory counts inside each API process. redis counts in REDIS_URL so every replica
# shares one window; if Redis is unreachable the API counts in memory until it is back.
RATE_LIMIT_BACKEND=memory
# Crawl sources and webhooks may not reach loopback, private or link-local addresses.
# true lifts that; only for crawling an intranet from a trusted deployment.
ALLOW_PRIVATE_NETWORK_TARGETS=false
# Largest page or sitemap the crawler will download, in bytes.
CRAWL_MAX_RESPONSE_BYTES=5000000
# /docs, /redoc and /openapi.json. Unset: on outside production, off in production.
# API_DOCS_ENABLED=true

# --- Storage --------------------------------------------------------------
# Zero-setup default: one SQLite file plus FAISS indexes on disk.
DATABASE_URL=sqlite+aiosqlite:///./data/embaid.sqlite
SEARCH_BACKEND=sqlite_faiss             # sqlite_faiss | postgres (needs pgvector) | qdrant
FAISS_INDEX_DIR=./data/indices
# Postgres instead (see README > Configuration > Storage):
# DATABASE_URL=postgresql+asyncpg://embaid:embaid@localhost:5432/embaid
# SEARCH_BACKEND=postgres
# Qdrant for search (uv sync --extra qdrant; QDRANT_URL=:memory: runs it in-process):
# SEARCH_BACKEND=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=embaid

# Uploaded files: local disk by default. Fill these in to use S3 or MinIO.
STORAGE_ENDPOINT_URL=
STORAGE_BUCKET=embaid
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Background jobs ------------------------------------------------------
# false: ingestion runs inside the API process (simplest, no Redis needed).
# true: jobs go to Redis and a separate worker process runs them:
#   uv run arq src.tasks.worker.WorkerSettings
# If Redis is unreachable the API logs a warning and falls back to inline jobs.
QUEUE_ENABLED=false
REDIS_URL=redis://localhost:6379

# --- Models ---------------------------------------------------------------
# REQUIRED: pick one setup. Keys are only read from here and never leave your server
# except in calls to the provider you choose.
#
# A) Fully local and free with Ollama (https://ollama.com):
#      ollama pull llama3 && ollama pull nomic-embed-text
#    DEFAULT_CHAT_PROVIDER=ollama
#    DEFAULT_CHAT_MODEL=llama3
#    DEFAULT_EMBEDDING_PROVIDER=ollama
#    DEFAULT_EMBEDDING_MODEL=nomic-embed-text
#    EMBEDDING_DIMENSIONS=768
#
# B) Cloud models (the defaults below): an Anthropic key for chat and an OpenAI key
#    for embeddings. Mixing is fine, e.g. Ollama embeddings with a cloud chat model.
#
# C) Any OpenAI-compatible service: set its key below and use its name as the provider,
#    e.g. DEFAULT_CHAT_PROVIDER=groq. Chat: openrouter, groq, gemini, deepseek,
#    openai_compatible. Embeddings: gemini, openai_compatible.
#
# These are defaults for new projects; each project can change its models later.
# Changing the embedding model or dimensions means re-indexing existing documents.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# https://console.groq.com/keys
GROQ_API_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Your own OpenAI-compatible server (vLLM, LM Studio, Together, Mistral, a gateway...).
# The key is optional for servers that do not check one.
# e.g. http://localhost:8001/v1
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
# Enterprise clouds. Bedrock and Vertex need an extra install (uv sync --extra bedrock / vertex)
# and use their standard credentials: AWS profiles or roles, and
# `gcloud auth application-default login` or a service account for Google Cloud.
# Azure: the model name is your deployment name.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AWS_REGION=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
DEFAULT_CHAT_PROVIDER=anthropic         # anthropic | openai | ollama | openrouter | groq | gemini | deepseek | openai_compatible | azure_openai | bedrock | vertex
# claude-sonnet-5, or claude-sonnet-5-5 for the newer Sonnet at the same price
DEFAULT_CHAT_MODEL=claude-sonnet-5
DEFAULT_EMBEDDING_PROVIDER=openai       # openai | ollama | gemini | openai_compatible | azure_openai | bedrock | vertex
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536               # must match the embedding model

# --- Retrieval ------------------------------------------------------------
# Reranking: "local" runs a cross-encoder on this machine (needs: uv sync --extra rerank;
# skipped without it). "cohere" or "jina" use their hosted APIs instead: no extra install,
# but each question's candidate passages are sent to that service.
RERANK_ENABLED=true
RERANK_PROVIDER=local
# Optional model override for the hosted rerankers (defaults: rerank-v3.5 / jina-reranker-v2-base-multilingual)
RERANK_API_MODEL=
COHERE_API_KEY=
JINA_API_KEY=
SEMANTIC_CACHE_ENABLED=true
# Writes a short locating sentence per chunk with the chat model while indexing.
# Better retrieval, but one model call per chunk: slower and costlier to ingest.
CONTEXTUAL_EMBEDDING_ENABLED=true

# --- Optional -------------------------------------------------------------
# "Continue with Google" on the login page, and Google Docs import.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:8000
# Error reporting; empty sends nothing anywhere.
SENTRY_DSN=
# Path to a built widget.js. Usually unnecessary: the API finds the monorepo build
# (apps/widget/dist/widget.js) and the copy inside the Docker image on its own.
# WIDGET_BUNDLE_PATH=
